<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.victorbueno.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UtesaConcurrencyApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.victorbueno.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.auth.ActividadLogin"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.ActividadRegistro"
            android:exported="false"
            android:parentActivityName=".ui.auth.ActividadLogin" />

        <activity
            android:name=".ui.dashboard.ActividadPanel"
            android:exported="false" />

        <activity
            android:name=".ui.users.ActividadListaUsuarios"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.ActividadPanel" />

        <activity
            android:name=".ui.dashboard.ActividadActividadReciente"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.ActividadPanel" />

        <activity
            android:name=".ui.users.ActividadDetalleUsuario"
            android:exported="false"
            android:parentActivityName=".ui.users.ActividadListaUsuarios" />

        <activity
            android:name=".ui.users.ActividadFormularioUsuario"
            android:exported="false"
            android:parentActivityName=".ui.users.ActividadListaUsuarios" />

        <activity
            android:name=".ui.benchmark.ActividadPruebaConcurrencia"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.ActividadPanel" />

        <activity
            android:name=".ui.profile.ActividadPerfil"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.ActividadPanel" />

        <activity
            android:name=".ui.files.ActividadGestionArchivos"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.ActividadPanel" />

    </application>

</manifest>
